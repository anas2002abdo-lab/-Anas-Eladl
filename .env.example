# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
APP_PUBLIC_BASE_URL=""

# GOOGLE SIGN-IN (Optional for Web portal; Android uses Firebase google-services.json)
GOOGLE_WEB_CLIENT_ID=""

# PRIMARY PERSISTENT DATABASE (Google Cloud SQL PostgreSQL via Drizzle ORM)
# Injected automatically by AI Studio / Cloud Run when Cloud SQL is provisioned
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# FREE OPEN-SOURCE MAPS & ROUTING (OpenStreetMap / OSRM / Nominatim)
# For commercial production, host dedicated private OSRM & Nominatim instances (see infra/osrm_profiles/README.md)
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_CAR_URL=""
OSRM_MOTO_URL=""
OSRM_TUKTUK_URL=""
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="OtlobhaRides/2.0 (support@otlobha.eg)"
OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# FIREBASE CLOUD MESSAGING (Push Notifications - Firebase Admin SDK, NEVER put secrets in Flutter)
# Option 1 (Recommended for Cloud Run Secret Manager): full service account JSON (raw or base64)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option 2: Individual service account fields
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# EGYPTIAN PAYMENT GATEWAY (Paymob / Fawry / Kashier - Optional for Phase 2)
PAYMOB_API_KEY=""
PAYMOB_HMAC_SECRET=""

# FREE EMAIL OTP VIA SMTP (e.g. Gmail App Password - 100% Free)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Otlobha اطلبها <no-reply@otlobha.eg>"

# AUTHENTICATION & RBAC SECRETS (REQUIRED IN PRODUCTION — MIN 32 CHARS EACH)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# FIRST SUPER ADMIN BOOTSTRAP (SET VIA ENV ONLY — NEVER HARDCODE)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME=""

# SQLITE STORAGE (Set OTLOBHA_DB_PATH=/data/otlobha.db & DELETE journal mode on Cloud Run GCS FUSE)
OTLOBHA_DB_PATH="./otlobha.db"
OTLOBHA_SQLITE_JOURNAL_MODE="WAL"

PORT="3000"
