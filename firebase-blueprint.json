        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "beneficiaryName", "beneficiaryType", "grossEarnings", "deductedCommissions", "netPayout", "payoutMethod", "status", "sourceCreatedAt", "createdAt", "updatedAt"]
    },
    "PlatformConfigRecord": {
      "title": "PlatformConfigRecord",
      "description": "Persistent platform operational configuration item (zone, service config, pricing rule, coupon, payment or dispatch setting).",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "configGroup": {
          "type": "string",
          "enum": ["service_configs", "service_zones", "pricing_rules", "dispatch_config", "coupons", "payment_settings", "financial_model_settings", "invoice_design_settings"]
        },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "configGroup", "data", "createdAt", "updatedAt"]
    },
    "ConnectionTestRecord": {
      "title": "ConnectionTestRecord",
      "description": "Read-only connection verification sentinel.",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      },
      "required": ["ok"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Authorized admin accounts for the cloud persistence vault."
    },
    "/vault_meta/{metaId}": {
      "schema": { "$ref": "#/entities/VaultMeta" },
      "description": "Master cloud sync metadata and entity counters."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "Permanent customer accounts and credentials."
    },
    "/captains/{captainId}": {
      "schema": { "$ref": "#/entities/CaptainRecord" },
      "description": "Permanent captain accounts, vehicle profiles, and cash limits."
    },
    "/captain_documents/{docId}": {
      "schema": { "$ref": "#/entities/CaptainDocumentRecord" },
      "description": "Permanent captain KYC verification documents."
    },
    "/merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/MerchantRecord" },
      "description": "Permanent merchant accounts, settings, and commissions."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryRecord" },
      "description": "Permanent catalog and marketplace categories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/ProductRecord" },
      "description": "Permanent merchant catalog products."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Permanent customer orders."
    },
    "/order_stores/{orderStoreId}": {
      "schema": { "$ref": "#/entities/OrderStoreRecord" },
      "description": "Permanent multi-store order legs."
    },
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/TripRecord" },
      "description": "Permanent ride-hailing trips."
    },
    "/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/DeliveryRecord" },
      "description": "Permanent parcel deliveries."
    },
    "/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/WalletRecord" },
      "description": "Permanent captain, merchant, and customer wallets and balances."
    },
    "/ledger_entries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntryRecord" },
      "description": "Permanent financial ledger entries."
    },
    "/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/SettlementRecord" },
      "description": "Permanent payout settlements."
    },
    "/platform_configs/{configId}": {
      "schema": { "$ref": "#/entities/PlatformConfigRecord" },
      "description": "Permanent operational platform configurations."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionTestRecord" },
      "description": "Startup Firestore connection verification path."
    }
  }
}
