        "customerPhone": { "type": "string", "maxLength": 40 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "captainId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "minLength": 1, "maxLength": 48 },
        "totalAmount": { "type": "number" },
        "sourceCreatedAt": { "type": "string", "maxLength": 64 },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "orderNumber", "customerId", "customerName", "customerPhone", "merchantId", "captainId", "status", "totalAmount", "sourceCreatedAt", "extra", "createdAt", "updatedAt"]
    },
    "OrderStoreRecord": {
      "title": "OrderStoreRecord",
