        "sourceCreatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "transactionGroupId", "accountCode", "accountType", "debit", "credit", "referenceType", "referenceId", "descriptionAr", "idempotencyKey", "sourceCreatedAt", "createdAt", "updatedAt"]
    },
    "SettlementRecord": {
      "title": "SettlementRecord",
      "description": "Persistent payout settlement record for captains and merchants.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "beneficiaryName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "beneficiaryType": { "type": "string", "minLength": 1, "maxLength": 48 },
