        "email": { "type": "string", "maxLength": 180 },
        "passwordHash": { "type": "string", "maxLength": 260 },
        "businessNameAr": { "type": "string", "minLength": 1, "maxLength": 180 },
        "businessNameEn": { "type": "string", "maxLength": 180 },
        "merchantType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "zoneName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "commissionRate": { "type": "number" },
        "verificationStatus": { "type": "string", "maxLength": 40 },
        "isOpenNow": { "type": "boolean" },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "email", "passwordHash", "businessNameAr", "businessNameEn", "merchantType", "zoneName", "phone", "commissionRate", "verificationStatus", "isOpenNow", "extra", "createdAt", "updatedAt"]
    },
    "CategoryRecord": {
      "title": "CategoryRecord",
      "description": "Persistent store and marketplace category.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
