        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "deliveryNumber", "senderName", "senderPhone", "captainId", "status", "deliveryFee", "sourceCreatedAt", "extra", "createdAt", "updatedAt"]
    },
    "WalletRecord": {
      "title": "WalletRecord",
      "description": "Persistent financial wallet balance for captains, merchants, and customers.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ownerType": { "type": "string", "enum": ["captain", "merchant", "customer", "platform"] },
        "availableBalance": { "type": "number" },
        "pendingBalance": { "type": "number" },
        "isFrozen": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "userId", "ownerName", "ownerType", "availableBalance", "pendingBalance", "isFrozen", "createdAt", "updatedAt"]
    },
    "LedgerEntryRecord": {
      "title": "LedgerEntryRecord",
      "description": "Persistent double-entry financial ledger entry.",
