      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prepStatus": { "type": "string", "maxLength": 48 },
        "subtotal": { "type": "number" },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "orderId", "merchantId", "prepStatus", "subtotal", "extra", "createdAt", "updatedAt"]
    },
