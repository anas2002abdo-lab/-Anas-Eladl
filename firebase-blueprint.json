        "isActive": { "type": "boolean" },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "scope", "merchantId", "nameAr", "nameEn", "sortOrder", "isActive", "extra", "createdAt", "updatedAt"]
    },
    "ProductRecord": {
      "title": "ProductRecord",
      "description": "Persistent merchant catalog product.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "merchantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
