{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized Firebase administrator granted access to the Otlobha persistent cloud vault.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "ops_admin"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "ownerUid", "createdAt", "updatedAt"]
    },
    "VaultMeta": {
      "title": "VaultMeta",
      "description": "Master cloud synchronization state and entity counts for automatic recovery after updates or container restarts.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "version": { "type": "integer" },
        "customersCount": { "type": "integer" },
        "ordersCount": { "type": "integer" },
        "tripsCount": { "type": "integer" },
        "deliveriesCount": { "type": "integer" },
        "captainsCount": { "type": "integer" },
        "merchantsCount": { "type": "integer" },
        "categoriesCount": { "type": "integer" },
        "productsCount": { "type": "integer" },
        "walletsCount": { "type": "integer" },
        "ledgerEntriesCount": { "type": "integer" },
        "settlementsCount": { "type": "integer" },
        "lastSourceFingerprint": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "version",
        "customersCount",
        "ordersCount",
        "tripsCount",
        "deliveriesCount",
        "captainsCount",
        "merchantsCount",
        "categoriesCount",
        "productsCount",
        "walletsCount",
        "ledgerEntriesCount",
        "settlementsCount",
        "lastSourceFingerprint",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerRecord": {
      "title": "CustomerRecord",
      "description": "Persistent customer account profile, credentials hash, and default address/zone.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "maxLength": 180 },
        "phone": { "type": "string", "maxLength": 40 },
        "passwordHash": { "type": "string", "maxLength": 260 },
        "status": { "type": "string", "enum": ["active", "suspended", "blocked", "deleted"] },
        "defaultZoneId": { "type": "string", "maxLength": 128 },
        "addressLandmark": { "type": "string", "maxLength": 400 },
        "isEmailVerified": { "type": "boolean" },
        "sourceCreatedAt": { "type": "string", "maxLength": 64 },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "fullName", "email", "phone", "passwordHash", "status", "defaultZoneId", "addressLandmark", "isEmailVerified", "sourceCreatedAt", "extra", "createdAt", "updatedAt"]
    },
    "CaptainRecord": {
      "title": "CaptainRecord",
      "description": "Persistent captain account, vehicle profile, verification state, and cash balance limits.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "username": { "type": "string", "maxLength": 120 },
        "passwordHash": { "type": "string", "maxLength": 260 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "nationalId": { "type": "string", "maxLength": 64 },
        "zoneName": { "type": "string", "maxLength": 120 },
        "vehicleType": { "type": "string", "maxLength": 64 },
        "verificationStatus": { "type": "string", "maxLength": 40 },
        "availabilityStatus": { "type": "string", "maxLength": 40 },
        "cashOnHand": { "type": "number" },
        "cashLimit": { "type": "number" },
        "ratingAvg": { "type": "number" },
        "completedCount": { "type": "integer" },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "userId", "username", "passwordHash", "fullName", "phone", "nationalId", "zoneName", "vehicleType", "verificationStatus", "availabilityStatus", "cashOnHand", "cashLimit", "ratingAvg", "completedCount", "extra", "createdAt", "updatedAt"]
    },
    "CaptainDocumentRecord": {
      "title": "CaptainDocumentRecord",
      "description": "Persistent captain KYC verification document.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "captainId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "docType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "labelAr": { "type": "string", "maxLength": 160 },
        "reviewStatus": { "type": "string", "maxLength": 40 },
        "extra": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "ownerUid", "captainId", "docType", "labelAr", "reviewStatus", "extra", "createdAt", "updatedAt"]
    },
    "MerchantRecord": {
      "title": "MerchantRecord",
      "description": "Persistent merchant store account, credentials, payout details, commission rate, and logo.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
